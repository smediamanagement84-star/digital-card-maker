# CardChemy Environment Variables
# Copy this file to .env.local and fill in your values

# ===== SUPABASE CONFIGURATION =====
# Get these from: https://supabase.com/dashboard/project/_/settings/api

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anonymous/public key (safe to expose in client)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ===== OPTIONAL: VERCEL BLOB STORAGE =====
# Only needed if using Vercel Blob for photo uploads
# Get from: https://vercel.com/dashboard/stores

# Vercel Blob read/write token (keep secret - server-side only)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your-token-here

# ===== DEVELOPMENT NOTES =====
# 1. Never commit .env.local to git (it's in .gitignore)
# 2. For production, add these to Vercel environment variables
# 3. Make sure Google OAuth is configured in Supabase Auth settings
# 4. Add authorized redirect URLs:
#    - http://localhost:3000/auth/callback (local)
#    - https://your-domain.vercel.app/auth/callback (production)
